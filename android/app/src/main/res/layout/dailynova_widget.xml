<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dn_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dailynova_widget_bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily Nova"
        android:textColor="#FF69B4"
        android:textSize="12sp"
        android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/dn_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/dn_row1_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F5F5FF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dn_row1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:textColor="#FF69B4"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dn_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/dn_row2_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F5F5FF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dn_row2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:textColor="#FF69B4"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dn_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/dn_row3_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F5F5FF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dn_row3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:textColor="#FF69B4"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dn_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/dn_row4_text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#F5F5FF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/dn_row4_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:textColor="#FF69B4"
                android:textSize="12sp" />
        </LinearLayout>

    <TextView
        android:id="@+id/dn_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="No upcoming reminders"
        android:textColor="#9AA0B5"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
